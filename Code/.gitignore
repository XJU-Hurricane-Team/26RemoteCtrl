# dot files
/.settings
/.eide/log
/.eide.usr.ctx.json

# project out
build
Build/Debug/
/bin
/obj
/out

# eide template
*.ept
*.eide-template

# macOS files
.DS_Store
__MACOSX__

# User-specific uVision files
*.opt
*.uvopt
*.uvoptx
*.uvgui
*.uvgui.*
*.uvguix.*

# Machine-specific TouchGFX config (IDE-specific makefiles)
CubeMX/TouchGFX/config/

# TouchGFX cache files (regenerated on build)
CubeMX/TouchGFX/generated/**/cache/
CubeMX/TouchGFX/generated/**/*.cache

# TouchGFX simulator files (PC only, not needed for embedded build)
CubeMX/TouchGFX/generated/simulator/

# TouchGFX font Unicode lists (intermediate files)
CubeMX/TouchGFX/generated/fonts/UnicodeList*.txt

# TouchGFX user.config (machine-specific path)
CubeMX/TouchGFX/generated/user.config
